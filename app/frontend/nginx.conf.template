# Front (fichiers construits par Vite) et relais /api vers le backend.
# ${BACKEND_URL} est remplacé au démarrage du conteneur (image nginx officielle).
server {
    listen 80;
    root /usr/share/nginx/html;

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_read_timeout 300s;     # LLM : jusqu'à quelques minutes
        client_max_body_size 1m;
    }

    location / {
        try_files $uri /index.html;
    }
}
